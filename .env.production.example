# ==============================================================================
# TIMEX CERAMIC - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# On Hostinger KVM 2 (VPS), place these in /var/www/timex-ceramic/.env.production
# or in your systemd / PM2 ecosystem configuration.
# IMPORTANT: Never commit actual passwords, secrets, or private API keys to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & DOMAIN CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# Canonical public URL (Never hardcode localhost in production templates)
# Used for SEO canonicals, sitemap generation, Open Graph, and email asset links
NEXT_PUBLIC_SITE_URL=https://www.timexceramic.com

# Backend Express API routing
# In local development: Express runs on port 5001, Next.js rewrites /api/v1 -> localhost:5001
# On Hostinger KVM 2 (VPS): Nginx reverse proxies /api/ to the backend Express service
BACKEND_INTERNAL_URL=http://localhost:5001
# NEXT_PUBLIC_API_URL=https://www.timexceramic.com/api/v1

# ------------------------------------------------------------------------------
# 2. EMAIL AUTOMATION & SMTP CONFIGURATION (HOSTINGER KVM 2 & PRODUCTION)
# ------------------------------------------------------------------------------
# Timex Ceramic automatically dispatches two separate emails for every enquiry:
# 1) Admin Notification -> Sent to ADMIN_NOTIFICATION_EMAIL
# 2) Customer Thank-You Confirmation -> Sent directly to customer's submitted email
#
# Primary Production Transport: SMTP (Standard Hostinger Business Email)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@timexceramic.com
SMTP_PASS=your_email_password_here
SMTP_FROM_EMAIL="Timex Ceramic <info@timexceramic.com>"
ADMIN_NOTIFICATION_EMAIL=info@timexceramic.com

# Alternative SMTP Port Configuration (TLS/STARTTLS):
# SMTP_PORT=587
# SMTP_SECURE=false

# Optional Resend API Key (Used as fallback or primary if SMTP_* is unset):
# NOTE: For Resend, your domain must be verified at resend.com/domains before
# sending emails to external customer email addresses. Unverified test domains
# (like onboarding@resend.dev) can only deliver to the account owner email.
RESEND_API_KEY=

# Backward compatibility recipients (falls back to ADMIN_NOTIFICATION_EMAIL if unset):
ENQUIRY_EMAIL=webmaster@ambestmedia.com
RECIPIENT_EMAIL=webmaster@ambestmedia.com

# ------------------------------------------------------------------------------
# HOSTINGER KVM 2 / VPS EMAIL DELIVERABILITY GUIDE
# ------------------------------------------------------------------------------
# To ensure 100% email inbox delivery (and prevent messages landing in SPAM):
#
# 1. Hostinger Business Email SMTP Details:
#    - SMTP Host: smtp.hostinger.com
#    - SMTP Port: 465 (SSL/TLS) or 587 (STARTTLS)
#    - SMTP Secure: true (for port 465), false (for port 587)
#    - Authentication: Enabled (use full email address e.g. info@timexceramic.com)
#
# 2. Required DNS Records (Add in your Domain Registrar / DNS Manager):
#    - SPF Record (TXT):
#        Name:  @ (or timexceramic.com)
#        Value: v=spf1 include:_spf.mail.hostinger.com ~all
#    - DKIM Record (TXT / CNAME):
#        Generate inside Hostinger hPanel -> Emails -> Manage Email -> DNS / DKIM
#        Name:  hostingermail._domainkey
#        Value: (Generated key provided by Hostinger)
#    - DMARC Record (TXT):
#        Name:  _dmarc
#        Value: v=DMARC1; p=none; sp=none; rua=mailto:dmarc-reports@timexceramic.com
#
# 3. Domain Sender Verification:
#    Always ensure SMTP_FROM_EMAIL matches the authenticated domain (@timexceramic.com).
#    Sending emails from free webmail accounts (e.g. @gmail.com) via Hostinger SMTP
#    will fail SPF/DMARC alignment and get rejected by Gmail/Outlook spam filters.
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# 3. PERSISTENT DATABASE CONFIGURATION (MYSQL)
# ------------------------------------------------------------------------------
# On Hostinger KVM 2: Install and configure local MySQL server (or remote RDS)
# Connection via DATABASE_URL:
# DATABASE_URL=mysql://timex_user:secure_password@127.0.0.1:3306/timex_ceramic

# Or configure individual MySQL credentials:
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=timex_user
MYSQL_PASSWORD=your_database_password_here
MYSQL_DATABASE=timex_ceramic
MYSQL_SSL=false

# Resilient Fallback: If no MySQL credentials are provided or MySQL is offline,
# the system safely uses its persistent JSON fallback store (server/data/store.json)
# retaining all products, categories, blogs, and customer enquiries without data loss.

# ------------------------------------------------------------------------------
# 4. ADMIN AUTHENTICATION
# ------------------------------------------------------------------------------
# Secret key used to sign and verify admin JSON Web Tokens (JWT).
# Generate a random 64-character string for production:
JWT_SECRET=timex_ceramic_admin_super_secret_jwt_key_2026_change_in_production

# Default admin credentials:
# Username: admin
# Password: (Set on first admin initialization or through database)
